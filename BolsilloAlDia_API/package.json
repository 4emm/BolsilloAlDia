{
  "name": "bolsillo-al-dia-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "create-user": "tsx --env-file=.env scripts/create-user.mts",
    "reset-user": "tsx --env-file=.env scripts/reset-user.mts",
    "smoke": "tsx --env-file=.env scripts/smoke.mts",
    "emulators": "npx --yes firebase-tools@latest emulators:start --only auth,firestore --project demo-bolsillo"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
